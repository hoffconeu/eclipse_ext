<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension point="org.eclipse.ui.commands">
        <category
            id="com.oje.eclipse.hello.commands.category"
            name="OJE Tools"/>
        <command
            id="com.oje.eclipse.hello.commands.sayHello"
            categoryId="com.oje.eclipse.hello.commands.category"
            name="Hello World anzeigen"/>
        <command
            id="com.oje.eclipse.hello.commands.checkSelection"
            categoryId="com.oje.eclipse.hello.commands.category"
            name="ABAP-Auswahl lokal pruefen"/>
        <command
            id="com.oje.eclipse.hello.commands.cryptoTest"
            categoryId="com.oje.eclipse.hello.commands.category"
            name="Verschluesselung mit Testtext pruefen"/>
        <command
            id="com.oje.eclipse.hello.commands.teamsPopupProbe"
            categoryId="com.oje.eclipse.hello.commands.category"
            name="Teams-Popups lokal pruefen"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler
            commandId="com.oje.eclipse.hello.commands.sayHello"
            class="com.oje.eclipse.hello.handlers.HelloHandler"/>
        <handler
            commandId="com.oje.eclipse.hello.commands.checkSelection"
            class="com.oje.eclipse.hello.handlers.SourceSelectionHandler"/>
        <handler
            commandId="com.oje.eclipse.hello.commands.cryptoTest"
            class="com.oje.eclipse.hello.handlers.CryptoTestHandler"/>
        <handler
            commandId="com.oje.eclipse.hello.commands.teamsPopupProbe"
            class="com.oje.eclipse.hello.handlers.TeamsPopupProbeHandler"/>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution locationURI="menu:help?after=additions">
            <command
                commandId="com.oje.eclipse.hello.commands.sayHello"
                label="OJE Hello World"
                style="push"/>
            <command
                commandId="com.oje.eclipse.hello.commands.checkSelection"
                label="OJE ABAP-Auswahl pruefen (lokal)"
                style="push"/>
            <command
                commandId="com.oje.eclipse.hello.commands.cryptoTest"
                label="OJE Verschluesselungstest (nur Testtext)"
                style="push"/>
            <command
                commandId="com.oje.eclipse.hello.commands.teamsPopupProbe"
                label="OJE Teams-Popups pruefen (nur lokal)"
                style="push"/>
        </menuContribution>
        <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
            <toolbar id="com.oje.eclipse.hello.toolbar">
                <command
                    commandId="com.oje.eclipse.hello.commands.sayHello"
                    label="OJE Hello World"
                    style="push"/>
            </toolbar>
        </menuContribution>
    </extension>
</plugin>
