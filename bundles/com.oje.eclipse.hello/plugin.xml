<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension point="org.eclipse.ui.commands">
        <category
            id="com.oje.eclipse.hello.commands.category"
            name="OJE Tools"/>
        <command
            id="com.oje.eclipse.hello.commands.sayHello"
            categoryId="com.oje.eclipse.hello.commands.category"
            name="Hello World anzeigen"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler
            commandId="com.oje.eclipse.hello.commands.sayHello"
            class="com.oje.eclipse.hello.handlers.HelloHandler"/>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution locationURI="menu:help?after=additions">
            <command
                commandId="com.oje.eclipse.hello.commands.sayHello"
                label="OJE Hello World"
                style="push"/>
        </menuContribution>
        <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
            <toolbar id="com.oje.eclipse.hello.toolbar">
                <command
                    commandId="com.oje.eclipse.hello.commands.sayHello"
                    label="OJE Hello World"
                    style="push"/>
            </toolbar>
        </menuContribution>
    </extension>
</plugin>
