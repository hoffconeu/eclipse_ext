/commands
    Cache-Control: no-cache, no-store, must-revalidate

/commands.html
    Cache-Control: no-cache, no-store, must-revalidate

/commands.js
    Cache-Control: no-cache, no-store, must-revalidate

/commands-feed
    Cache-Control: no-cache, no-store, must-revalidate

/commands-chat
    Cache-Control: no-store

/commands-chat.html
    Cache-Control: no-store

/commands-chat.js
    Cache-Control: no-store

/commands-chat-api
    Cache-Control: no-store
